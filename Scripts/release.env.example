# Copy this file to Scripts/release.env (gitignored) and fill in your values.
# release.sh reads it automatically; variables exported before running the
# script always override what's set here.

# Codesign identity: the "Developer ID Application: Name (TEAMID)" string from
# `security find-identity -v -p codesigning`, or its SHA-1 hash. Leave unset to
# auto-detect the first "Developer ID Application" identity in the keychain.
#SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization: pick ONE of the two methods below.

# Method A: a stored notarytool keychain profile. Profiles are per team, not per
# app, so one created for another project works here too.
#NOTARY_PROFILE="buildkite-notch"

# Method B: App Store Connect API key (takes priority over NOTARY_PROFILE when
# all three are set). App Store Connect -> Users and Access -> Integrations ->
# Keys. The .p8 can only be downloaded once; never commit it.
#APPLE_API_KEY_PATH="/path/to/AuthKey_XXXX.p8"
#APPLE_API_KEY_ID="XXXXXXXXXX"
#APPLE_API_ISSUER_ID="00000000-0000-0000-0000-000000000000"

# Homebrew tap that receives the cask on `make publish`.
#TAP_REPO="nickolasdeluca/homebrew-tap"
